# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (Milestone 3)
DATABASE_URL=postgresql://postgres:password@localhost:5432/mentis

# Auth (Milestone 13)
AUTH_JWT_SECRET=change-me-in-production-use-a-long-random-string
AUTH_ACCESS_TOKEN_TTL_MINUTES=15
AUTH_REFRESH_TOKEN_TTL_DAYS=30
AUTH_PASSWORD_RESET_TTL_MINUTES=60
# Consente accesso API senza login in locale (usa DEV_USER_ID)
AUTH_DEV_FALLBACK=false

# Dev user (seed + login locale/E2E)
DEV_USER_ID=00000000-0000-4000-8000-000000000001
DEV_SUBJECT_ID=00000000-0000-4000-8000-000000000002
NEXT_PUBLIC_DEV_SUBJECT_ID=00000000-0000-4000-8000-000000000002
# Credenziali seed: paolo.dev@mentis.local / mentis-dev-password

# Storage (Milestone 15)
# local = filesystem dev | s3 = cloud remoto (produzione)
STORAGE_PROVIDER=local
UPLOAD_STORAGE_PATH=./storage/uploads
STORAGE_BUCKET=
STORAGE_REGION=eu-west-1
# Opzionale per MinIO / Cloudflare R2
STORAGE_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
STORAGE_SIGNED_URL_TTL_SECONDS=3600
STORAGE_FORCE_PATH_STYLE=false
STORAGE_SIGNING_SECRET=

# Upload
MAX_UPLOAD_FILE_SIZE_MB=20
MAX_UPLOAD_FILES=50

# AI (Milestone 5)
# OpenAI diretto: lascia OPENAI_BASE_URL vuoto
# OpenRouter: https://openrouter.ai/api/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_APP_NAME=Mentis
OPENAI_HTTP_REFERER=http://localhost:3000
# OpenAI diretto: gpt-4o-mini
# OpenRouter — usa modelli DIVERSI per OCR e estrazione:
#   OCR (foto):     google/gemma-4-26b-a4b-it:free
#   Estrazione JSON: google/gemini-2.5-flash  (più affidabile, costo basso)
# Lista free: https://openrouter.ai/collections/free-models
AI_VISION_MODEL=gpt-4o-mini
AI_REASONING_MODEL=gpt-4o-mini
KNOWLEDGE_JSON_VERSION=1.0.0
AI_PROMPT_VERSION=1.3.0
# Avvia elaborazione AI subito dopo upload (richiede OPENAI_API_KEY)
AUTO_PROCESS_AFTER_UPLOAD=false

# AI Cost Optimization (Milestone 16)
AI_MAX_CONCURRENT_REQUESTS=3
AI_MIN_REQUEST_DELAY_MS=200
AI_RETRY_MAX_ATTEMPTS=3
AI_RETRY_BASE_DELAY_MS=1000
AI_CACHE_TTL_DAYS=30
AI_OCR_BATCH_SIZE=3
AI_COST_INPUT_PER_MILLION=0.15
AI_COST_OUTPUT_PER_MILLION=0.60
AI_VISION_COST_INPUT_PER_MILLION=0.15
AI_VISION_COST_OUTPUT_PER_MILLION=0.60

# Feed Engine (Milestone 6)
FEED_SESSION_TARGET_CARDS=20

# Performance (Milestone 17)
QUERY_CACHE_TTL_SECONDS=60
SERVER_QUERY_CACHE_TTL_SECONDS=30

# Production hardening (Milestone 20)
# In produzione: AUTH_DEV_FALLBACK=false, STORAGE_PROVIDER=s3, JWT >= 32 caratteri
# Health checks: GET /api/health (liveness), GET /api/ready (readiness + DB)
# Avvio produzione con migrazioni automatiche: npm run start:production

# Testing (Milestone 19)
# Opzionale: necessario solo per test di integrazione database
# DATABASE_URL=postgresql://mentis:mentis@localhost:5432/mentis_test
